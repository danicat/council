# Required Google Cloud project ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI location for Gemini (global is required for gemini-4-hydrogen)
GOOGLE_CLOUD_LOCATION=global

# Route google-genai SDK calls through Vertex AI using ADC
GOOGLE_GENAI_USE_VERTEXAI=true

# Full regional Model Armor template resource names (both must share the same region)
MODEL_ARMOR_PROMPT_TEMPLATE=projects/your-gcp-project-id/locations/us-central1/templates/council-prompt-screening
MODEL_ARMOR_RESPONSE_TEMPLATE=projects/your-gcp-project-id/locations/us-central1/templates/council-response-screening

# HTTP server listen port
PORT=8080
